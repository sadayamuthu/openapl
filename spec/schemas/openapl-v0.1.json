{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openapl.org/schema/v0.1/schema.json",
  "title": "OpenAPL policy file v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["openapl", "policy", "version"],
  "properties": {
    "openapl": { "type": "string", "pattern": "^0\\.1$" },
    "policy": { "$ref": "#/$defs/slug" },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "metadata": { "type": "object" },
    "compliance": {
      "type": "array",
      "items": { "enum": ["NIST-800-53", "SOC2"] }
    },
    "principals": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9-]*$" },
      "additionalProperties": { "$ref": "#/$defs/principal" }
    },
    "humans": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": { "const": "idp" },
        "match": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "groups_claim": { "type": "string" },
            "roles_claim": { "type": "string" }
          }
        }
      }
    },
    "entitlements": {
      "type": "array",
      "items": { "$ref": "#/$defs/entitlement" }
    },
    "deny": {
      "type": "array",
      "items": { "$ref": "#/$defs/denyRule" }
    },
    "delegation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_depth": { "type": "integer", "minimum": 1, "maximum": 10 },
        "require_human_origin": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "actionList": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "issSub": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iss", "sub"],
      "properties": {
        "iss": { "type": "string" },
        "sub": { "type": "string" }
      }
    },
    "principal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "identity", "owner"],
      "properties": {
        "kind": { "enum": ["agent", "service"] },
        "identity": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "spiffe": { "type": "string" },
            "oauth_client_id": { "type": "string" },
            "entra_app_id": { "type": "string" },
            "jwt": { "$ref": "#/$defs/issSub" }
          }
        },
        "owner": { "type": "string" },
        "acts_for": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["who", "actions"],
            "properties": {
              "who": { "type": "string", "pattern": "^(user|group|role):.+$" },
              "actions": { "$ref": "#/$defs/actionList" }
            }
          }
        },
        "may_delegate": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["to", "actions"],
            "properties": {
              "to": { "$ref": "#/$defs/slug" },
              "actions": { "$ref": "#/$defs/actionList" }
            }
          }
        }
      }
    },
    "entitlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "grant_to", "action", "resource"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "grant_to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "action": { "type": "string" },
        "resource": { "type": "string" },
        "when": { "type": "array", "items": { "type": "string" } },
        "purpose": { "type": "string" },
        "expires": { "type": "string", "pattern": "^(task|never|[0-9]+[smhd])$" },
        "otherwise": {
          "type": "string",
          "pattern": "^require_approval\\((role|group|user):[^)]+\\)$"
        }
      }
    },
    "denyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "grant_to", "action", "resource"],
      "properties": {
        "id": { "$ref": "#/$defs/slug" },
        "grant_to": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "action": { "type": "string" },
        "resource": { "type": "string" },
        "when": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
