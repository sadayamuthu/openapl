#!/bin/sh
# bench/bin/cedar
# Runs the pinned Cedar CLI (image built by bench/tools.sh) on files in the current
# directory, mounted read-only, as the caller uid (CI temp dirs are 0700). Paths given to the CLI must be relative to $PWD.
exec docker run --rm -i --network none --user "$(id -u):$(id -g)" -v "$PWD":/work:ro -w /work \
  "${OPENAPL_BENCH_CEDAR_IMAGE:-openapl-bench/cedar:4.15.0}" "$@"
